{
  "name": "@wheelhouse/api",
  "version": "0.0.0",
  "private": true,
  "description": "The NestJS API: /mcp, /api/v1, /api/app, the GitHub webhook and the live streams. In the image it also serves the React app.",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "^0.5.9",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "^12.1.3",
    "@wheelhouse/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5"
  }
}
