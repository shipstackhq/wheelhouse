# Copy to .env on the server and fill in. Never commit .env.

# Public URL of the app (used in invite and reset links).
APP_URL=https://wheelhouse.example.com

# Existing Postgres container: create a dedicated role + database first (see docs/deploy.md).
# The host name is the Postgres container's name on POSTGRES_NETWORK.
DATABASE_URL=postgres://wheelhouse:CHANGE_ME@postgres:5432/wheelhouse
POSTGRES_NETWORK=CHANGE_ME_docker_network_of_the_postgres_container

# Signups. false (recommended): only the very first account can sign up, after that owners add members.
# true: anyone can create a team. Unset: open in development, closed in production.
ALLOW_SIGNUP=false

# Where the host's Caddy reaches the app (bound to 127.0.0.1 only).
WHEELHOUSE_PORT=3000
# Pin to a commit SHA tag in production, e.g. ghcr.io/shipstackhq/wheelhouse:abc1234
WHEELHOUSE_IMAGE=ghcr.io/shipstackhq/wheelhouse:latest

# Optional: enables Ask-the-map. Leave empty to keep Ask off.
ANTHROPIC_API_KEY=
