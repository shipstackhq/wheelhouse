# Copy to .env on the server and fill in. Never commit .env.

# Public URL of the app (used in invite and reset links).
APP_URL=https://wheelhouse.example.com

# Existing Postgres container: create a dedicated role + database first (see docs/deploy.md).
# The host name is the Postgres container's name on POSTGRES_NETWORK.
DATABASE_URL=postgres://wheelhouse:CHANGE_ME@postgres:5432/wheelhouse
POSTGRES_NETWORK=CHANGE_ME_docker_network_of_the_postgres_container

# Signups. false (recommended): only the very first account can sign up, after that owners add members.
# true: anyone can create a workspace. Unset: open in development, closed in production.
ALLOW_SIGNUP=false

# Invite-only signup (WH-49).
# Comma-separated emails of instance admins: only they can invite someone into a brand new workspace.
ADMIN_EMAILS=you@example.com
# Seats per workspace, owner included; pending invites count. Default 5.
MAX_WORKSPACE_MEMBERS=5
# How long an invite link works, in hours. Default 168 (7 days).
INVITE_TTL_HOURS=168

# Where the host's Caddy reaches the app (bound to 127.0.0.1 only).
WHEELHOUSE_PORT=3000
# Pin to a commit SHA tag in production, e.g. ghcr.io/shipstackhq/wheelhouse:abc1234
WHEELHOUSE_IMAGE=ghcr.io/shipstackhq/wheelhouse:latest

# Used by deploy/deploy.sh for the pre-deploy dump (docker exec into the Postgres container).
PG_CONTAINER=CHANGE_ME_postgres_container_name
PG_DUMP_USER=postgres
PG_DB=wheelhouse

# Object storage for uploaded files (workspace images, profile pictures). One interface, swappable adapters.
# local (default): files under STORAGE_DIR (default .data/uploads); mount it as a volume in Docker.
# s3: any S3-compatible service (AWS S3, Cloudflare R2, MinIO, Garage...); set the STORAGE_S3_* values.
STORAGE_DRIVER=local
STORAGE_DIR=
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# true (default): endpoint/bucket/key, what self-hosted servers need. false: bucket.endpoint/key.
STORAGE_S3_PATH_STYLE=true

# Optional: enables Ask-the-map. Leave empty to keep Ask off.
ANTHROPIC_API_KEY=

# GitHub App (optional): report every push and link pull requests and CI to issues. Leave all six empty to keep it off;
# repositories linked from a machine with the plugin or CLI still work. See "GitHub App" in docs/deploy.md.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The App's private key (.pem). One line with literal \n is fine.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# For "Request user authorization (OAuth) during installation": proves who is connecting an installation.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# What chat answers may do in Wheelhouse (comma-separated; read is always on, planning:write is never granted to chat).
# CHAT_SCOPES=read makes every chat read-only.
CHAT_SCOPES=read,board:write,map:write,docs:write
