      "text": "Wheelhouse",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "nrK-1uReYjgnr-LmOrdxg",
      "originalText": "Wheelhouse",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "tp_4c_Lvs1kJiFJwWTvFv",
      "type": "text",
      "x": 1092.5006390110802,
      "y": 350.73382513988076,
      "width": 1287.8392333984375,
      "height": 1025,
      "angle": 0,
      "strokeColor": "#1e1e1e",
