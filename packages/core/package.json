{
  "name": "@wheelhouse/core",
  "version": "0.0.0",
  "private": true,
  "description": "Schema, migrations, service layer and the framework-free libraries behind Wheelhouse. No Next.js, no React, no HTTP framework.",
  "exports": {
    "./db": "./src/db/index.ts",
    "./db/*": "./src/db/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@electric-sql/pglite": "^0.5.9",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
