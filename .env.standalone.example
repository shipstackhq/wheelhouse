# Copy to .env next to docker-compose.standalone.yml. Never commit .env.
# The three that must be set:
POSTGRES_PASSWORD=CHANGE_ME_a_long_random_password
# The address people use, with scheme: https://wheelhouse.example.com, or http://localhost for a trial on this machine.
APP_URL=http://localhost
# What Caddy answers on. A domain name gets a certificate from Let's Encrypt automatically (ports 80 and 443 must reach this
# machine). `:80` is plain HTTP.
SITE_ADDRESS=:80

# Everything else (ALLOW_SIGNUP, ADMIN_EMAILS, MAX_TEAM_MEMBERS, INVITE_TTL_HOURS, ANTHROPIC_API_KEY and the GITHUB_* settings)
# is the same as .env.example, and can be added here.
ALLOW_SIGNUP=false
ADMIN_EMAILS=you@example.com
