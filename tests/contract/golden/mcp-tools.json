        "unlink_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_version": {
          "description": "Version you last read. If the team changed it since, the call fails with a conflict instead of overwriting their edit.",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "session": {
          "type": "string",
          "description": "Client session id. Leave this out: the Claude Code plugin sets it automatically on every call. Only non-Claude-Code clients that track their own sessions pass it."
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    }
