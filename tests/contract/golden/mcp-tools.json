  {
    "name": "create_issue",
    "readOnly": false,
    "inputSchema": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string",
          "description": "Team key (e.g. \"WH\") or id"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "status": {
          "description": "Status name, default Backlog",
          "type": "string"
        },
        "priority": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "urgent"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent": {
          "description": "Make it a sub-issue of this issue (a ref like WH-12 in the same team)",
          "type": "string"
        },
        "assignee": {
          "description": "\"me\" (you, or your key claims it), or a member's name or email",
          "type": "string"
        },
        "cycle": {
          "description": "\"current\", \"next\" or a cycle number",
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "enum": [
                "current",
                "next"
              ]
            }
          ]
        },
        "project": {
          "description": "Project name or id (the team must take part in it)",
          "type": "string"
        },
        "milestone": {
          "description": "Milestone name or id of that project",
          "type": "string"
        },
        "targets": {
          "description": "Where the work happens, in order; a sub-issue without its own uses its parent's. Each branch is checked on GitHub. Replaces the list; [] clears it",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "description": "A connected repository: its id or \"owner/name\""
              },
              "branch": {
                "description": "Branch to start from; the repository's default when left out",
                "type": "string"
              }
            },
            "required": [
              "repository"
            ],
            "additionalProperties": false
          }
        },
        "link_nodes": {
          "description": "Graph node names/ids this issue touches",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session": {
          "type": "string",
          "description": "Client session id. Leave this out: the Claude Code plugin sets it automatically on every call. Only non-Claude-Code clients that track their own sessions pass it."
        }
      },
      "required": [
        "team",
        "title"
      ],
      "additionalProperties": false
    }
  },
