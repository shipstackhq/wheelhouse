{
  "name": "wheelhouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @wheelhouse/api start",
    "dev": "pnpm --filter @wheelhouse/api dev",
    "build": "pnpm --filter @wheelhouse/web build",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "test": "pnpm --filter @wheelhouse/core test && pnpm --filter @wheelhouse/api test && pnpm --filter @wheelhouse/api-client test && pnpm --filter @wheelhouse/web test && tsx --conditions=react-server --test \"tests/*.test.ts\"",
    "db:generate": "pnpm --filter @wheelhouse/core db:generate",
    "test:contract": "tsx --conditions=react-server tests/contract/run.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @wheelhouse/core typecheck && pnpm --filter @wheelhouse/api typecheck && pnpm --filter @wheelhouse/api-client typecheck && pnpm --filter @wheelhouse/web typecheck",
    "db:migrate": "tsx packages/core/src/tools/db-cli.ts migrate",
    "db:export": "tsx packages/core/src/tools/db-cli.ts export",
    "db:import": "tsx packages/core/src/tools/db-cli.ts import",
    "db:verify": "tsx packages/core/src/tools/db-cli.ts verify",
    "map:reanchor": "tsx packages/core/src/tools/reanchor-cli.ts",
    "map:after-migration": "tsx packages/core/src/tools/post-migration-map-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@wheelhouse/core": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "5.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
