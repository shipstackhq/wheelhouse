{
  "name": "wheelhouse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx scripts/seed.ts",
    "test": "pnpm --filter @wheelhouse/core test && pnpm --filter @wheelhouse/api test && pnpm --filter @wheelhouse/api-client test && pnpm --filter @wheelhouse/web test && tsx --conditions=react-server --test \"src/**/*.test.ts\" && tsx --tsconfig tsconfig.test.json --test \"src/**/*.test.tsx\"",
    "db:generate": "pnpm --filter @wheelhouse/core db:generate",
    "test:contract": "tsx --conditions=react-server tests/contract/run.ts",
    "typecheck": "tsc --noEmit && pnpm --filter @wheelhouse/core typecheck && pnpm --filter @wheelhouse/api typecheck && pnpm --filter @wheelhouse/api-client typecheck && pnpm --filter @wheelhouse/web typecheck",
    "db:export": "tsx packages/core/src/tools/db-cli.ts export",
    "db:import": "tsx packages/core/src/tools/db-cli.ts import",
    "db:verify": "tsx packages/core/src/tools/db-cli.ts verify"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.9",
    "@lexical/code": "^0.52.0",
    "@lexical/headless": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@wheelhouse/core": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "elkjs": "^0.12.0",
    "lexical": "^0.52.0",
    "next": "15.5.27",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
